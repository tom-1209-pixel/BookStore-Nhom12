<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BookStore.Admin.Views.TrangThongKe"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BookStore.Admin.Models">

    <ScrollViewer Padding="22,16">
        <StackPanel Spacing="18" MaxWidth="1100" HorizontalAlignment="Left">

            <StackPanel>
                <TextBlock Text="{x:Bind ViewModel.LoiChao}" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.NgayHomNay}"
                           Style="{StaticResource BodyTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.ThongBaoLoi, Mode=OneWay, Converter={StaticResource ChuoiCoNoiDung}}"
                     Severity="Error" IsClosable="False"
                     Message="{x:Bind ViewModel.ThongBaoLoi, Mode=OneWay}" />

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.DangTai, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}" />

            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Đơn chờ xác nhận" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Height="34" />
                        <TextBlock Text="{x:Bind ViewModel.SoLieu.SoDonChoXacNhan, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Đơn đang giao" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Height="34" />
                        <TextBlock Text="{x:Bind ViewModel.SoLieu.SoDonDangGiao, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Đơn hoàn thành tháng này" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Height="34" />
                        <TextBlock Text="{x:Bind ViewModel.SoLieu.SoDonHoanThanhThangNay, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Doanh thu tháng này" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Height="34" />
                        <TextBlock Text="{x:Bind ViewModel.SoLieu.DoanhThuHienThi, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Sách sắp hết hàng" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" Height="34" />
                        <TextBlock Text="{x:Bind ViewModel.SoLieu.SoSachSapHetHang, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" FontSize="26" />
                    </StackPanel>
                </Border>
            </ItemsControl>

            <TextBlock Text="Sách bán chạy trong tháng" Style="{StaticResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="4">
                <ListView ItemsSource="{x:Bind ViewModel.TopSach}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:SachBanChay">
                            <Grid Padding="8,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind TenSach}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind SoLuongBan}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="{x:Bind DoanhThuHienThi}" HorizontalAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Button Content="Làm mới số liệu" Command="{x:Bind ViewModel.NapCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</Page>
