<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BookStore.Admin.Views.TrangBaoCao"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BookStore.Admin.Models">

    <ScrollViewer Padding="18,14">
        <StackPanel Spacing="14">
            <TextBlock Text="Báo cáo thống kê" Style="{StaticResource TitleTextBlockStyle}" />

            <StackPanel Orientation="Horizontal" Spacing="10">
                <CalendarDatePicker Header="Từ ngày" DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                    Date="{x:Bind ViewModel.TuNgay, Mode=TwoWay}" />
                <CalendarDatePicker Header="Đến ngày" DateFormat="{}{day.integer}/{month.integer}/{year.full}"
                                    Date="{x:Bind ViewModel.DenNgay, Mode=TwoWay}" />
                <Button Content="Xem báo cáo" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.XemCommand}" />
                <Button Content="7 ngày qua" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BayNgayQuaCommand}" />
                <Button Content="Tháng này" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.ThangNayCommand}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Xuất Excel doanh thu" Command="{x:Bind ViewModel.XuatExcelDoanhThuCommand}" />
                <Button Content="Xuất Excel nhập – xuất – tồn" Command="{x:Bind ViewModel.XuatExcelNhapXuatTonCommand}" />
                <TextBlock VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Tập tin được lưu vào thư mục Documents\BookStore và mở bằng Excel." />
            </StackPanel>

            <InfoBar IsOpen="{x:Bind ViewModel.CoThongBao, Mode=OneWay}" IsClosable="True"
                     Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />
            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.DangTai, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}" />

            <!-- Cac the so lieu tong hop -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Tổng doanh thu" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DoanhThu.TongDoanhThuHienThi, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Đơn hoàn thành" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DoanhThu.SoDonHoanThanh, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Sách bán ra" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DoanhThu.SoSachBanRa, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource TheSoLieu}">
                    <StackPanel>
                        <TextBlock Text="Trung bình mỗi đơn" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DoanhThu.TrungBinhHienThi, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Bieu do thanh doanh thu theo ngay (ve bang Rectangle, khong can thu vien) -->
                <Border Grid.Column="0" Padding="14"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Doanh thu theo ngày (chỉ tính đơn Hoàn thành – BR09)"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ItemsControl ItemsSource="{x:Bind ViewModel.TheoNgay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:DoanhThuNgay">
                                    <Grid ColumnSpacing="8" Padding="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind NgayHienThi}" FontSize="12" />
                                        <Rectangle Grid.Column="1" Height="14" HorizontalAlignment="Left" RadiusX="3" RadiusY="3"
                                                   Width="{x:Bind DoRongThanh}"
                                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DoanhThuHienThi}" FontSize="12"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="16">
                    <Border Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Sách bán chạy" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TopSach}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:SachBanChay">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TenSach}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SoLuongBan}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind DoanhThuHienThi}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Padding="14"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Đơn hàng theo trạng thái" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DonTheoTrangThai}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DonTheoTrangThai">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TenTrangThai}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SoDon}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind TongTienHienThi}" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Bao cao nhap - xuat - ton -->
            <Border Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Spacing="6">
                    <TextBlock Text="Nhập – xuất – tồn trong kỳ" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="8" Padding="0,4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mã" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Tên sách" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Tồn đầu" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Nhập" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Xuất" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Tồn cuối" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NhapXuatTon}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:NhapXuatTon">
                                <Grid ColumnSpacing="8" Padding="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="90" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind MaSach}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind TenSach}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind TonDauKy}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind NhapTrongKy}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind XuatTrongKy}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind TonCuoiKy}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
