<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="BookStore.Admin.Views.DangNhapWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Đăng nhập – Hệ thống quản lý nhà sách">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Border Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="32">
            <StackPanel Spacing="14">

                <TextBlock Text="📚" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="Ứng dụng quản trị nhà sách"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Dành cho quản lý nhà sách"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,-10,0,6" />

                <TextBox x:Name="OTenDangNhap" Header="Tên đăng nhập"
                         Text="{x:Bind ViewModel.TenDangNhap, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <PasswordBox x:Name="OMatKhau" Header="Mật khẩu"
                             PasswordChanged="OMatKhau_PasswordChanged"
                             KeyDown="OMatKhau_KeyDown" />

                <InfoBar IsOpen="{x:Bind ViewModel.CoLoi, Mode=OneWay}"
                         Severity="Error" IsClosable="False"
                         Message="{x:Bind ViewModel.ThongBaoLoi, Mode=OneWay}" />

                <Button Content="Đăng nhập" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.DangNhapCommand}"
                        IsEnabled="{x:Bind ViewModel.ChoPhepBam, Mode=OneWay}" />

                <ProgressRing IsActive="{x:Bind ViewModel.DangXuLy, Mode=OneWay}"
                              HorizontalAlignment="Center" Width="24" Height="24" />

                <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextWrapping="Wrap" HorizontalAlignment="Center"
                           Text="Tài khoản demo: quanly / 123456. Tài khoản khách hàng không đăng nhập được vào đây." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
