<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BookStore.Admin.Views.TrangKho"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BookStore.Admin.Models">

    <Grid Padding="18,14" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quản lý kho và nhập hàng" Style="{StaticResource TitleTextBlockStyle}" />

        <InfoBar Grid.Row="1" IsOpen="{x:Bind ViewModel.CoThongBao, Mode=OneWay}" IsClosable="True"
                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

        <ProgressBar Grid.Row="2" IsIndeterminate="True"
                     Visibility="{x:Bind ViewModel.DangTai, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}" />

        <Pivot Grid.Row="3">
            <!-- ======================= The Phieu nhap ======================= -->
            <PivotItem Header="Phiếu nhập">
                <Grid ColumnSpacing="16" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Padding="12,10">
                                <Button Content="Lập phiếu mới" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.PhieuMoiCommand}" />
                                <Button Content="Làm mới danh sách" Command="{x:Bind ViewModel.NapPhieuNhapCommand}" />
                            </StackPanel>
                            <Grid Grid.Row="1" Padding="14,8" ColumnSpacing="8"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Nhà cung cấp" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Tổng tiền" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Trạng thái" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="2"
                                      ItemsSource="{x:Bind ViewModel.DanhSachPhieu}"
                                      ItemContainerStyle="{StaticResource DongDanhSach}"
                                      SelectedItem="{x:Bind ViewModel.PhieuDangChon, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:PhieuNhap">
                                        <Grid Padding="4,8" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind MaPhieuNhap}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind TenNCC}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind NgayLapHienThi}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind TongTienHienThi}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind TenTrangThai}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock Text="{x:Bind ViewModel.TieuDeForm, Mode=OneWay}"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />

                                <ComboBox Header="Nhà cung cấp" HorizontalAlignment="Stretch"
                                          IsEnabled="{x:Bind ViewModel.ChoPhepSua, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.NhaCungCaps}"
                                          SelectedItem="{x:Bind ViewModel.FormNhaCungCap, Mode=TwoWay}" />

                                <TextBox Header="Ghi chú" IsEnabled="{x:Bind ViewModel.ChoPhepSua, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.FormGhiChu, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Text="Sách nhập" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.ChoPhepSua, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Header="Sách" HorizontalAlignment="Stretch"
                                              ItemsSource="{x:Bind ViewModel.SachCoTheNhap}"
                                              SelectedItem="{x:Bind ViewModel.DongMoiSach, Mode=TwoWay}" />
                                    <NumberBox Grid.Column="1" Header="Số lượng" Minimum="1"
                                               Value="{x:Bind ViewModel.DongMoiSoLuong, Mode=TwoWay, Converter={StaticResource IntSangDouble}}" />
                                    <NumberBox Grid.Column="2" Header="Giá nhập (đ)" Minimum="0"
                                               Value="{x:Bind ViewModel.DongMoiGia, Mode=TwoWay, Converter={StaticResource DecimalSangDouble}}" />
                                    <Button Grid.Column="3" Content="Thêm" VerticalAlignment="Bottom"
                                            Command="{x:Bind ViewModel.ThemDongCommand}" />
                                </Grid>

                                <ListView ItemsSource="{x:Bind ViewModel.DongPhieu}" MinHeight="80" MaxHeight="260"
                                          SelectedItem="{x:Bind ViewModel.DongDangChon, Mode=TwoWay}"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DongPhieuNhap">
                                            <TextBlock Text="{x:Bind MoTa}" Padding="0,6" TextWrapping="Wrap" />
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Grid>
                                    <Button Content="Xóa dòng đang chọn" Command="{x:Bind ViewModel.XoaDongCommand}"
                                            IsEnabled="{x:Bind ViewModel.ChoPhepSua, Mode=OneWay}" />
                                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Style="{StaticResource BodyStrongTextBlockStyle}">
                                        <Run Text="Tổng tiền: " /><Run Text="{x:Bind ViewModel.TongTienForm, Mode=OneWay}" />
                                    </TextBlock>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                    <Button Content="Lưu phiếu" Style="{StaticResource AccentButtonStyle}"
                                            IsEnabled="{x:Bind ViewModel.ChoPhepSua, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.LuuPhieuCommand}" />
                                    <Button Content="Hoàn thành phiếu nhập"
                                            IsEnabled="{x:Bind ViewModel.ChoPhepHoanThanh, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.HoanThanhCommand}" />
                                    <Button Content="Xóa phiếu"
                                            IsEnabled="{x:Bind ViewModel.ChoPhepXoa, Mode=OneWay}"
                                            Command="{x:Bind ViewModel.XoaPhieuCommand}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Text="Theo BR06, phiếu ở trạng thái Chờ nhập chưa ảnh hưởng tồn kho. Khi bấm Hoàn thành, số lượng từng sách được cộng vào tồn kho và phiếu không thể sửa hay xóa nữa." />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- ======================= The Ton kho ======================= -->
            <PivotItem Header="Tồn kho">
                <Grid ColumnSpacing="16" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Padding="12,10" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" PlaceholderText="Tìm theo tên sách hoặc ISBN"
                                         Text="{x:Bind ViewModel.TuKhoaTon, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OTuKhoaTon_KeyDown" />
                                <CheckBox Grid.Column="1" Content="Chỉ sách sắp hết"
                                          IsChecked="{x:Bind ViewModel.ChiSapHetHang, Mode=TwoWay}" />
                                <Button Grid.Column="2" Content="Tìm" Command="{x:Bind ViewModel.NapTonKhoCommand}" />
                            </Grid>
                            <Grid Grid.Row="1" Padding="14,8" ColumnSpacing="8"
                                  Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Mã" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="Tên sách" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="Tồn" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Ngưỡng" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="4" Text="Cảnh báo" FontWeight="SemiBold" />
                            </Grid>
                            <ListView Grid.Row="2"
                                      ItemsSource="{x:Bind ViewModel.DanhSachTonKho}"
                                      ItemContainerStyle="{StaticResource DongDanhSach}"
                                      SelectedItem="{x:Bind ViewModel.TonDangChon, Mode=TwoWay}"
                                      SelectionMode="Single">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:TonKho">
                                        <Grid Padding="4,8" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="80" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind MaSach}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{x:Bind TenSach}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind TenLoaiSach}"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{x:Bind SoLuongTon}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind NguongCanhBao}" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind CanhBao}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Ngưỡng cảnh báo hết hàng" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="Sách có số lượng tồn nhỏ hơn hoặc bằng ngưỡng sẽ được đánh dấu Sắp hết và đếm vào màn hình Tổng quan." />
                            <TextBlock Text="{x:Bind ViewModel.TonDangChon.TenSach, Mode=OneWay}"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                            <NumberBox Header="Ngưỡng mới" Minimum="0" SpinButtonPlacementMode="Compact"
                                       IsEnabled="{x:Bind ViewModel.CoTonDangChon, Mode=OneWay}"
                                       Value="{x:Bind ViewModel.NguongMoi, Mode=TwoWay, Converter={StaticResource IntSangDouble}}" />
                            <Button Content="Lưu ngưỡng" Style="{StaticResource AccentButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.CoTonDangChon, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.LuuNguongCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
