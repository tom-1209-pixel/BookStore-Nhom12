<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BookStore.Admin.Views.TrangSach"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BookStore.Admin.Models"
    xmlns:vm="using:BookStore.Admin.ViewModels">

    <Grid Padding="18,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quản lý sách" Style="{StaticResource TitleTextBlockStyle}" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="Tìm theo tên sách, ISBN hoặc tác giả"
                     Text="{x:Bind ViewModel.TuKhoa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OTuKhoa_KeyDown" />
            <Button Grid.Column="1" Content="Tìm" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.NapDuLieuCommand}" />
            <Button Grid.Column="2" Content="Thêm sách mới" Command="{x:Bind ViewModel.LamMoiFormCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.DangTai, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}" />

                    <Grid Grid.Row="1" Padding="14,10" ColumnSpacing="8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="42" />
                            <ColumnDefinition Width="*" MinWidth="140" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="112" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mã" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Tên sách" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Giá bán" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Tồn" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Trạng thái" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="2" x:Name="ODanhSachSach" x:FieldModifier="private"
                              ItemsSource="{x:Bind ViewModel.DanhSachSach}"
                              ItemContainerStyle="{StaticResource DongDanhSach}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItem="{x:Bind ViewModel.SachDangChon, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Sach">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" MinWidth="140" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="112" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind MaSach}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind TenSach}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind TenLoaiSach}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind GiaBanHienThi}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind SoLuongTon}" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind TrangThaiHienThi}" FontSize="12" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <ScrollViewer>
                    <StackPanel Spacing="12">
                        <TextBlock Text="{x:Bind ViewModel.TieuDeForm, Mode=OneWay}"
                                   Style="{StaticResource SubtitleTextBlockStyle}" />

                        <InfoBar IsOpen="{x:Bind ViewModel.CoThongBao, Mode=OneWay}" IsClosable="True"
                                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

                        <TextBox Header="Tên sách"
                                 Text="{x:Bind ViewModel.FormTenSach, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox Header="ISBN"
                                 Text="{x:Bind ViewModel.FormIsbn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Header="Loại sách" HorizontalAlignment="Stretch"
                                  ItemsSource="{x:Bind ViewModel.DanhMuc}"
                                  SelectedItem="{x:Bind ViewModel.FormLoaiSach, Mode=TwoWay}" />

                        <NumberBox Header="Giá bán (đ)" SpinButtonPlacementMode="Compact" Minimum="0"
                                   Value="{x:Bind ViewModel.FormGiaBan, Mode=TwoWay, Converter={StaticResource DecimalSangDouble}}" />

                        <ComboBox Header="Nhà xuất bản" HorizontalAlignment="Stretch" PlaceholderText="(không chọn)"
                                  ItemsSource="{x:Bind ViewModel.NhaXuatBans}"
                                  SelectedItem="{x:Bind ViewModel.FormNhaXuatBan, Mode=TwoWay}" />

                        <TextBlock Text="Tác giả" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ListView ItemsSource="{x:Bind ViewModel.TacGias}" SelectionMode="None" MaxHeight="150"
                                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:LuaChonTacGia">
                                    <CheckBox Content="{x:Bind Ten}" IsChecked="{x:Bind DaChon, Mode=TwoWay}" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0" Header="Số lượng tồn" SpinButtonPlacementMode="Compact" Minimum="0"
                                       Value="{x:Bind ViewModel.FormSoLuongTon, Mode=TwoWay, Converter={StaticResource IntSangDouble}}" />
                            <NumberBox Grid.Column="1" Header="Ngưỡng cảnh báo" SpinButtonPlacementMode="Compact" Minimum="0"
                                       Value="{x:Bind ViewModel.FormNguongCanhBao, Mode=TwoWay, Converter={StaticResource IntSangDouble}}" />
                        </Grid>

                        <TextBox Header="Mô tả" AcceptsReturn="True" Height="90" TextWrapping="Wrap"
                                 Text="{x:Bind ViewModel.FormMoTa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ToggleSwitch Header="Trạng thái" OnContent="Đang kinh doanh" OffContent="Ngừng kinh doanh"
                                      IsOn="{x:Bind ViewModel.FormDangKinhDoanh, Mode=TwoWay}" />

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Lưu" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.LuuCommand}" />
                            <Button Content="Làm mới" Command="{x:Bind ViewModel.LamMoiFormCommand}" />
                            <Button Content="Xóa" Command="{x:Bind ViewModel.XoaCommand}"
                                    IsEnabled="{x:Bind ViewModel.DangSua, Mode=OneWay}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Text="Theo BR07, sách đã phát sinh đơn hàng hoặc phiếu nhập sẽ không bị xóa mà chỉ chuyển sang Ngừng kinh doanh." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
