<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="BookStore.Admin.Views.TrangDonHang"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:BookStore.Admin.Models">

    <Grid Padding="18,14" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Quản lý đơn hàng" Style="{StaticResource TitleTextBlockStyle}" />

        <!-- Thanh tim kiem va loc -->
        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" PlaceholderText="Tìm theo mã đơn, tên hoặc số điện thoại người nhận"
                     Text="{x:Bind ViewModel.TuKhoa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="OTuKhoa_KeyDown" />

            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.DanhSachBoLoc}"
                      SelectedItem="{x:Bind ViewModel.BoLocTrangThai, Mode=TwoWay}"
                      SelectionChanged="OBoLoc_SelectionChanged" />

            <Button Grid.Column="2" Content="Tìm" Style="{StaticResource AccentButtonStyle}"
                    Command="{x:Bind ViewModel.NapDanhSachCommand}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Danh sach don -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <ProgressBar Grid.Row="0" IsIndeterminate="True"
                                 Visibility="{x:Bind ViewModel.DangTai, Mode=OneWay, Converter={StaticResource BoolSangVisibility}}" />

                    <Grid Grid.Row="1" Padding="14,10" ColumnSpacing="8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="104" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Mã" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Người nhận" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Ngày đặt" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Tổng tiền" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Trạng thái" FontWeight="SemiBold" />
                    </Grid>

                    <ListView Grid.Row="2" x:Name="ODanhSachDon" x:FieldModifier="private"
                              ItemsSource="{x:Bind ViewModel.DanhSachDon}"
                              ItemContainerStyle="{StaticResource DongDanhSach}"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectionMode="Single"
                              SelectionChanged="ODanhSachDon_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DonHang">
                                <Grid Padding="4,8" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                        <ColumnDefinition Width="108" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{x:Bind MaDonHang}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind HoTenNguoiNhan}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SoDienThoaiNhan}" TextWrapping="NoWrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{x:Bind NgayDatHienThi}" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TongTienHienThi}"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <Border Grid.Column="4" CornerRadius="10" Padding="8,3"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Background="{x:Bind TrangThai, Converter={StaticResource TrangThaiDonSangMau}}">
                                        <TextBlock Text="{x:Bind TenTrangThai}" Foreground="White" FontSize="11" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Chi tiet don va cac thao tac -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="16,12">
                <ScrollViewer>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Chi tiết đơn hàng" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="17" />

                        <InfoBar IsOpen="{x:Bind ViewModel.CoThongBao, Mode=OneWay}"
                                 IsClosable="True"
                                 Message="{x:Bind ViewModel.ThongBao, Mode=OneWay}" />

                        <StackPanel x:Name="OChiTiet" x:FieldModifier="private" Spacing="7" Visibility="Collapsed">
                            <TextBlock x:Name="OMaDon" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock x:Name="OThongTinNhan" TextWrapping="Wrap" />

                            <TextBlock Text="Sách trong đơn" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                            <ItemsControl x:Name="ODongDon" x:FieldModifier="private">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DongDonHang">
                                        <Grid ColumnSpacing="8" Padding="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TenSach}"
                                                       TextTrimming="CharacterEllipsis" FontSize="13" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind SoLuong}"
                                                       HorizontalAlignment="Right" FontSize="13" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind ThanhTienHienThi}"
                                                       HorizontalAlignment="Right" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock x:Name="OTongTien" Style="{StaticResource BodyStrongTextBlockStyle}" />

                            <TextBlock Text="Lịch sử xử lý" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                            <ItemsControl x:Name="OLichSu" x:FieldModifier="private">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LichSuDonHang">
                                        <TextBlock Text="{x:Bind MoTa}" FontSize="12" Padding="0,2"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBox Header="Ghi chú cho thao tác" Margin="0,6,0,0"
                                     PlaceholderText="Ví dụ: khách hẹn giao lại ngày mai"
                                     Text="{x:Bind ViewModel.GhiChuThaoTac, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Text="Chuyển trạng thái" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Button Grid.Row="0" Grid.Column="0" Content="Xác nhận"
                                        HorizontalAlignment="Stretch"
                                        Style="{StaticResource AccentButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.ChoPhepXacNhan, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.XacNhanCommand}" />
                                <Button Grid.Row="0" Grid.Column="1" Content="Giao hàng"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ChoPhepGiao, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.GiaoHangCommand}" />
                                <Button Grid.Row="1" Grid.Column="0" Content="Hoàn thành"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ChoPhepHoanThanh, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.HoanThanhCommand}" />
                                <Button Grid.Row="1" Grid.Column="1" Content="Hủy đơn"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="{x:Bind ViewModel.ChoPhepHuy, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.HuyDonCommand}" />
                            </Grid>

                            <Button Content="In hóa đơn" HorizontalAlignment="Stretch" Margin="0,6,0,0"
                                    Command="{x:Bind ViewModel.InHoaDonCommand}" />
                        </StackPanel>

                        <TextBlock x:Name="OChuaChon" Text="Chọn một đơn hàng trong danh sách để xem chi tiết."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
