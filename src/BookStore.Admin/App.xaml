<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="BookStore.Admin.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="using:BookStore.Admin.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <cv:NghichDaoBoolConverter x:Key="NghichDaoBool" />
            <cv:BoolSangVisibilityConverter x:Key="BoolSangVisibility" />
            <cv:TrangThaiDonSangMauConverter x:Key="TrangThaiDonSangMau" />
            <cv:ChuoiCoNoiDungConverter x:Key="ChuoiCoNoiDung" />
            <cv:DecimalSangDoubleConverter x:Key="DecimalSangDouble" />
            <cv:IntSangDoubleConverter x:Key="IntSangDouble" />

            <!-- Mac dinh ListViewItem chi rong bang noi dung, khien cot co dan (*) bi co lai.
                 Style nay buoc moi dong giai het chieu ngang de cac cot thang hang voi dong tieu de. -->
            <Style x:Key="DongDanhSach" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="14,2" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- The hien thi mot con so tong hop tren man hinh Tong quan -->
            <Style x:Key="TheSoLieu" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,12" />
                <Setter Property="Width" Value="178" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
