@page "/tai-khoan/don-hang"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject IDonHangService DonHangService

<PageTitle>Đơn hàng của tôi</PageTitle>

<h1 class="h5 mb-3">Đơn hàng của tôi</h1>

<BangThongBao ThongBao="@ThongBao" Loi="@Loi" />

@if (_dsDon.Count == 0)
{
    <div class="khung-trang text-center py-5">
        <div style="font-size:2.5rem">📦</div>
        <p class="fw-semibold mb-1">Bạn chưa có đơn hàng nào.</p>
        <a class="btn btn-primary mt-2" href="/sach">Mua sách ngay</a>
    </div>
}
else
{
    @foreach (var don in _dsDon)
    {
        <div class="khung-trang mb-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 border-bottom pb-2 mb-2">
                <div>
                    <strong>Đơn #@don.MaDonHang</strong>
                    <span class="text-muted small ms-2">@don.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div>
                    <span class="badge @NhanTrangThai(don.TrangThai)">@don.TenTrangThai</span>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-7">
                    <ul class="list-unstyled mb-0 small">
                        @foreach (var d in don.Dong)
                        {
                            <li class="d-flex justify-content-between">
                                <span>@d.TenSach <span class="text-muted">× @d.SoLuong</span></span>
                                <span>@d.ThanhTien.ToString("#,##0") đ</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-5">
                    <div class="small text-muted">Giao đến: @don.HoTenNguoiNhan, @don.SoDienThoaiNhan</div>
                    <div class="small text-muted mb-2">@don.DiaChiGiao</div>
                    <div class="d-flex justify-content-between">
                        <span>Tổng cộng</span>
                        <span class="gia">@don.TongTien.ToString("#,##0") đ</span>
                    </div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <a class="btn btn-sm btn-outline-primary" href="@($"/ket-qua-dat-hang/{don.MaDonHang}")">
                    Xem chi tiết
                </a>

                @if (don.TrangThai == TrangThaiDonHang.ChoThanhToan && don.HinhThucThanhToan == HinhThucThanhToan.VNPay)
                {
                    <a class="btn btn-sm btn-primary" href="@($"/thanh-toan/vnpay/{don.MaDonHang}")">Thanh toán</a>
                }
                @if (don.TrangThai is TrangThaiDonHang.ChoThanhToan or TrangThaiDonHang.ChoXacNhan)
                {
                    <form method="post" action="/don-hang/huy" class="d-flex gap-2">
                        <AntiforgeryToken />
                        <input type="hidden" name="maDonHang" value="@don.MaDonHang" />
                        <input class="form-control form-control-sm" name="lyDo" style="width:14rem"
                               placeholder="Lý do hủy (tùy chọn)" maxlength="200" />
                        <button class="btn btn-sm btn-outline-danger" type="submit">Hủy đơn</button>
                    </form>
                }
                else if (don.TrangThai is TrangThaiDonHang.DaXacNhan or TrangThaiDonHang.DangGiao)
                {
                    <span class="text-muted small align-self-center">
                        Đơn đã được xác nhận nên không thể tự hủy (BR05).
                    </span>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter] private HttpContext? HttpCtx { get; set; }
    [SupplyParameterFromQuery] private string? ThongBao { get; set; }
    [SupplyParameterFromQuery] private string? Loi { get; set; }

    private List<DonHangDto> _dsDon = new();

    protected override async Task OnParametersSetAsync()
    {
        if (HttpCtx is null) return;
        var maKH = TaiKhoanEndpoints.LayMaKhachHang(HttpCtx.User);
        if (maKH is null) return;

        _dsDon = await DonHangService.LayDonCuaKhachAsync(maKH.Value);
    }

    private static string NhanTrangThai(TrangThaiDonHang tt) => tt switch
    {
        TrangThaiDonHang.ChoThanhToan => "bg-warning text-dark",
        TrangThaiDonHang.ChoXacNhan => "bg-info text-dark",
        TrangThaiDonHang.DaXacNhan => "bg-primary",
        TrangThaiDonHang.DangGiao => "bg-primary",
        TrangThaiDonHang.HoanThanh => "bg-success",
        TrangThaiDonHang.DaHuy => "bg-danger",
        _ => "bg-secondary"
    };
}
