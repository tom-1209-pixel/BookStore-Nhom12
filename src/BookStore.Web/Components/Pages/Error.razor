@page "/loi"
@using System.Diagnostics

<PageTitle>Đã xảy ra lỗi</PageTitle>

@* Trang loi chung cua trang Web (muc 4.5 Thiet ke thich ung). Chi hien thi
   thong bao than thien va ma truy vet, khong lo chi tiet ky thuat. *@

<div class="khung-trang text-center py-5">
    <div style="font-size:3rem">⚠️</div>
    <h1 class="h4 text-danger">Đã xảy ra lỗi khi xử lý yêu cầu</h1>
    <p class="text-muted">
        Hệ thống đã ghi nhận sự cố. Bạn vui lòng thử lại hoặc liên hệ nhà sách nếu lỗi tiếp tục xảy ra.
    </p>

    @if (CoMaTruyVet)
    {
        <p class="small text-muted">
            Mã truy vết để báo cho bộ phận kỹ thuật: <code>@MaTruyVet</code>
        </p>
    }

    <a class="btn btn-primary mt-2" href="/">Về trang chủ</a>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? MaTruyVet { get; set; }
    private bool CoMaTruyVet => !string.IsNullOrEmpty(MaTruyVet);

    protected override void OnInitialized() =>
        MaTruyVet = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
