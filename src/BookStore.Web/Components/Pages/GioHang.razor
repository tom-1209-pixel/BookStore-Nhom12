@page "/gio-hang"
@rendermode InteractiveServer
@inject IGioHangService GioHangService
@inject NavigationManager Nav

<PageTitle>Giỏ hàng</PageTitle>

<h1 class="h5 mb-3">Giỏ hàng của bạn</h1>

<BangThongBao ThongBao="@_thongBao" Loi="@_loi" />

<AuthorizeView>
    <NotAuthorized>
        <div class="khung-trang text-center py-5">
            <div style="font-size:2.5rem">🔒</div>
            <p class="fw-semibold mb-1">Bạn cần đăng nhập để xem giỏ hàng</p>
            <a class="btn btn-primary" href="/dang-nhap?duongDanTiep=/gio-hang">Đăng nhập</a>
        </div>
    </NotAuthorized>

    <Authorized>
        @if (_dangTai)
        {
            <div class="khung-trang text-center py-5 text-muted">Đang tải giỏ hàng…</div>
        }
        else if (_gio.Dong.Count == 0)
        {
            <div class="khung-trang text-center py-5">
                <div style="font-size:2.5rem">🛒</div>
                <p class="fw-semibold mb-1">Giỏ hàng đang trống</p>
                <a class="btn btn-primary mt-2" href="/sach">Bắt đầu chọn sách</a>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-lg-8">
                    <div class="khung-trang">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sách</th>
                                    <th class="text-end">Đơn giá</th>
                                    <th class="text-center" style="width:11rem">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in _gio.Dong)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <a href="@($"/sach/{d.MaSach}")"><AnhBiaSach DuongDan="@d.AnhBia" TenSach="@d.TenSach" Lop="anh-nho" /></a>
                                                <div>
                                                    <a href="@($"/sach/{d.MaSach}")" class="fw-semibold text-decoration-none">@d.TenSach</a>
                                                    <div class="text-muted small">Còn @d.SoLuongTon cuốn</div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-end">@d.DonGia.ToString("#,##0") đ</td>
                                        <td>
                                            <div class="input-group input-group-sm justify-content-center">
                                                <button class="btn btn-outline-secondary" type="button"
                                                        disabled="@(_dangXuLy || d.SoLuong <= 1)"
                                                        @onclick="() => DoiSoLuong(d, d.SoLuong - 1)">−</button>
                                                <input class="form-control text-center" style="max-width:4rem"
                                                       value="@d.SoLuong" readonly />
                                                <button class="btn btn-outline-secondary" type="button"
                                                        disabled="@(_dangXuLy || d.SoLuong >= d.SoLuongTon)"
                                                        @onclick="() => DoiSoLuong(d, d.SoLuong + 1)">+</button>
                                            </div>
                                        </td>
                                        <td class="text-end fw-semibold">@d.ThanhTien.ToString("#,##0") đ</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-danger" type="button"
                                                    disabled="@_dangXuLy" @onclick="() => XoaDong(d)">Xóa</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-2 d-flex justify-content-between">
                        <a class="btn btn-link" href="/sach">← Tiếp tục mua sách</a>
                        <button class="btn btn-link text-danger" type="button"
                                disabled="@_dangXuLy" @onclick="XoaHetGio">Xóa toàn bộ giỏ</button>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="khung-trang">
                        <h2 class="h6 mb-3">Tóm tắt đơn hàng</h2>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính (@_gio.TongSoLuong sản phẩm)</span>
                            <strong>@_gio.TamTinh.ToString("#,##0") đ</strong>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển</span>
                            <strong>
                                @if (_phiVanChuyen == 0)
                                {
                                    <span class="text-success">Miễn phí</span>
                                }
                                else
                                {
                                    @($"{_phiVanChuyen:#,##0} đ")
                                }
                            </strong>
                        </div>

                        @if (_phiVanChuyen > 0)
                        {
                            <div class="alert alert-light border small py-2">
                                Mua thêm <strong>@((QuyTacNghiepVu.NguongMienPhiVanChuyen - _gio.TamTinh).ToString("#,##0")) đ</strong>
                                để được miễn phí vận chuyển.
                            </div>
                        }

                        <hr />
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-semibold">Tổng cộng</span>
                            <span class="gia">@((_gio.TamTinh + _phiVanChuyen).ToString("#,##0")) đ</span>
                        </div>

                        <a class="btn btn-primary w-100" href="/thanh-toan">Tiến hành thanh toán</a>
                    </div>
                </div>
            </div>
        }
    </Authorized>
</AuthorizeView>

@code {
    [CascadingParameter] private Task<AuthenticationState>? TrangThaiXacThuc { get; set; }
    [SupplyParameterFromQuery] private string? ThongBao { get; set; }
    [SupplyParameterFromQuery] private string? Loi { get; set; }

    private GioHangDto _gio = new();
    private int? _maKhachHang;
    private bool _dangTai = true;
    private bool _dangXuLy;
    private string? _thongBao;
    private string? _loi;

    private decimal _phiVanChuyen => QuyTacNghiepVu.TinhPhiVanChuyen(_gio.TamTinh);

    protected override async Task OnInitializedAsync()
    {
        _thongBao = ThongBao;
        _loi = Loi;

        if (TrangThaiXacThuc is not null)
        {
            var state = await TrangThaiXacThuc;
            _maKhachHang = TaiKhoanEndpoints.LayMaKhachHang(state.User);
        }

        await NapGioAsync();
        _dangTai = false;
    }

    private async Task NapGioAsync()
    {
        if (_maKhachHang is null) return;
        _gio = await GioHangService.LayGioHangAsync(_maKhachHang.Value);
    }

    private async Task DoiSoLuong(DongGioHangDto dong, int soLuongMoi)
    {
        if (_maKhachHang is null) return;
        _dangXuLy = true;
        _loi = _thongBao = null;

        var kq = await GioHangService.CapNhatSoLuongAsync(_maKhachHang.Value, dong.MaSach, soLuongMoi);
        if (!kq.ThanhCong) _loi = kq.ThongBao;

        await NapGioAsync();
        _dangXuLy = false;
    }

    private async Task XoaDong(DongGioHangDto dong)
    {
        if (_maKhachHang is null) return;
        _dangXuLy = true;
        _loi = _thongBao = null;

        var kq = await GioHangService.XoaDongAsync(_maKhachHang.Value, dong.MaSach);
        _thongBao = kq.ThanhCong ? $"Đã xóa “{dong.TenSach}” khỏi giỏ hàng." : null;
        if (!kq.ThanhCong) _loi = kq.ThongBao;

        await NapGioAsync();
        _dangXuLy = false;
    }

    private async Task XoaHetGio()
    {
        if (_maKhachHang is null) return;
        _dangXuLy = true;
        await GioHangService.XoaGioAsync(_maKhachHang.Value);
        _thongBao = "Đã xóa toàn bộ giỏ hàng.";
        await NapGioAsync();
        _dangXuLy = false;
    }
}
