@* The hien thi mot quyen sach trong luoi san pham *@

<div class="the-sach">
    <a href="@($"/sach/{Sach.MaSach}")" class="bia text-decoration-none">
        <AnhBiaSach DuongDan="@Sach.AnhBia" TenSach="@Sach.TenSach" />
    </a>
    <a class="ten" href="@($"/sach/{Sach.MaSach}")">@Sach.TenSach</a>
    <div class="tac-gia">@(string.IsNullOrWhiteSpace(Sach.TenTacGia) ? "—" : Sach.TenTacGia)</div>
    <div class="mt-2 d-flex align-items-center justify-content-between">
        <span class="gia">@Sach.GiaBan.ToString("#,##0") đ</span>
        @if (Sach.ConHang)
        {
            <span class="badge bg-success-subtle text-success-emphasis">Còn @Sach.SoLuongTon</span>
        }
        else
        {
            <span class="badge bg-secondary-subtle text-secondary-emphasis">Hết hàng</span>
        }
    </div>
    <div class="mt-2">
        @if (Sach.ConHang)
        {
            <form method="post" action="/gio-hang/them">
                <AntiforgeryToken />
                <input type="hidden" name="maSach" value="@Sach.MaSach" />
                <input type="hidden" name="soLuong" value="1" />
                <input type="hidden" name="duongDanTiep" value="@DuongDanTiep" />
                <button class="btn btn-sm btn-primary w-100" type="submit">Thêm vào giỏ</button>
            </form>
        }
        else
        {
            <button class="btn btn-sm btn-secondary w-100" disabled>Tạm hết hàng</button>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SachDto Sach { get; set; } = default!;
    [Parameter] public string DuongDanTiep { get; set; } = "/";
}
